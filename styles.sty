\ProvidesPackage{styles}[16-12-2025]
% % % % % % % % %
% SYNTEX STYLES %
% % % % % % % % %

%% ENCODAGE
\usepackage[utf8]{inputenc}                         % évite certaines erreurs (notamment minted)

%% COULEURS
\usepackage{color}                                  % couleurs de base
\usepackage[dvipsnames]{xcolor}                     % couleurs avancées
\definecolor{OverleafGreen}{HTML}{098842}           % couleur verte OverleafGreen
\newcommand{\gris}[1]{\textcolor[gray]{0.7}{#1}}    % afficher du texte en gris clair

%% MATHÉMATIQUES
\usepackage{amsfonts}                               % polices mathématiques supplémentaires
\usepackage{amsmath}                                % environnements et commandes mathématiques
\usepackage{amssymb}                                % symboles mathématiques
\usepackage{mathptmx}                               % police Times pour le texte et les maths
\usepackage{bigints}                                % grands symboles d'intégrale
\usepackage{leftindex}                              % permet d'avoir un indice à gauche
\usepackage{mathtools}                              % permet des indices à gauche en mieux, et plus
\DeclareMathSizes{12}{14}{10}{7}                    % définit les tailles mathématiques

%% FORMATAGE DU TEXTE ET DE LA PAGE
\usepackage{transparent}                            % permet d'appliquer la transparence au texte/graphismes
\usepackage[T1]{fontenc}                            % gestion caractères accentués
\usepackage[export]{adjustbox}                      % options d'ajustement pour les boîtes
\usepackage{fix-cm}                                 % correction des problèmes avec les polices Computer Modern
\setlength\parindent{0pt}                           % supprime l'indentation des paragraphes
\usepackage{fancyhdr}                               % en-têtes et pieds de page
\fancypagestyle{page/n}{\fancyhf{}                  % défininition style "Page 1/5"
   \fancyfoot[C]{Page \thepage/\pageref{LastPage}}  % commande principale du style
   \renewcommand{\headrulewidth}{0pt}               % retire la ligne horizontale dan l'en-tête
}
\usepackage{changepage}                             % permet de déborder sur les marges

%% ICÔNES/SYMBOLES
\usepackage{wasysym}                                % ensemble de symboles divers
\usepackage{fontawesome5}                           % icônes Font Awesome 5

%% TABLEAUX, FIGURES ET LISTES
\usepackage{array}                                  % outils avancés pour la création de tableaux
\usepackage{float}                                  % améliore le positionnement des objets flottants
\usepackage{wrapfig}                                % permet d'habiller le texte autour d'une image ou d'une figure
\usepackage{subcaption}                             % permet de créer des sous-légendes pour figures/tableaux
\usepackage{enumitem}                               % personnalisation avancée des listes

%% LIENS
\usepackage{hyperref}                               % création de liens hypertextes dans le document
\hypersetup{
    colorlinks=true,                                % active la coloration des liens
    linktoc=all,                                    % rend tous les éléments du sommaire cliquables
    linkcolor=black,                                % couleur des liens internes
    urlcolor=blue                                   % couleur des URL
}


\counterwithin{section}{part}                       % réinitialisation section
\counterwithin{subsection}{section}                 % réinitialisation subection
\counterwithin{subsubsection}{subsection}           % réinitialisation subsubsection
% numérotation visuelle : (part.)section.subsection.subsubsection
\renewcommand\thesection{\arabic{section}}
\renewcommand\thesubsection     {\thesection.\arabic{subsection}}
\renewcommand\thesubsubsection  {\thesubsection.\arabic{subsubsection}}
\usepackage{lastpage}                               % permet de référencer le nombre total de pages

%%% IMPORTS
\usepackage{subfiles}                               % inclusion de sous-fichiers
\usepackage{standalone}                             % inclusion de fichiers autonomes

%% IMAGES, GRAPHIQUES, SCHÉMAS ET DESSINS
\usepackage{graphicx}                               % inclusion et gestion des images
%\usepackage[printwatermark]{xwatermark}            % inclusion d'un filigrane
\usepackage{tikz}                                   % création de schémas vectoriels avec TikZ
\usetikzlibrary{calc}                               % ajoute des outils de calcul pour TikZ
\tikzset{
    axe/.style={thin, ->, >=latex},                 % style pour dessiner des axes
    force/.style={very thick, ->},                  % style pour représenter des forces
    label/.style={midway, fill=white, scale=0.8}    % style pour positionner et styliser des labels
}
\usepackage[straightvoltages, RPvoltages]{circuitikz} % schémas électriques avec options de voltages
\tikzset{
    v_source/.style = {american voltage source}     % style pour la source de tension électrique
}

%% UNITÉS
\usepackage{siunitx}                                % gestion des unités SI et des nombres
\DeclareSIUnit\angstrom{\text {Å}}
\sisetup{
  locale = FR,                                      % configuration locale en français
  per-mode = fraction,                              % affiche les rapports en mode fraction
  output-decimal-marker = {,},                      % utilise la virgule comme séparateur décimal
  exponent-product = \cdot ,                        % produit en notation exponentielle
  separate-uncertainty = true,                      % affiche l'incertitude séparément
  input-digits = 0123456789\pi,                     % élargir les entrées numériques
}

%% DIVERS
\usepackage{comment}                                % permet d'ignorer de larges blocs de texte/commentaires
\usepackage{lipsum}                                 % permet d'écrire du texte de remplissage
\usepackage{minted}                                 % inclure des blocs de code

%% OPÉRATEURS PERSONNALISÉS
\DeclareMathOperator\cis{cis}                       % opérateur "cis" pour les nombres complexes
\DeclareMathOperator\cof{cof}                       % opérateur "cofacteur"
\DeclareMathOperator\adj{adj}                       % opérateur "adj"




